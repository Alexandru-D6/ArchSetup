#!/usr/bin/env python3
"""Small JSON interface for the control center. Never evaluates shell text."""
import concurrent.futures
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import desktop_wifi


def command(*args, optional=False):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=2 if optional else 12,
                                env=dict(os.environ, LC_ALL='C'))
        if result.returncode:
            raise ValueError(result.stderr.strip() or result.stdout.strip() or 'Command failed')
        return result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired, ValueError):
        if optional:
            return ''
        raise


def audio(kind):
    data = json.loads(command('pactl', '-f', 'json', 'list', kind, optional=True) or '[]')
    return [dict(id=item['name'], name=item.get('description') or item['name'],
                 muted=item.get('mute', False),
                 volume=round(sum(channel['value'] for channel in item.get('volume', {}).values())
                              / max(1, len(item.get('volume', {}))) / 65536 * 100))
            for item in data if not (kind == 'sources' and item['name'].endswith('.monitor'))]


def snapshot(device=''):
    probes = {
        'wifi': lambda: desktop_wifi.snapshot(device),
        'bluetooth': lambda: command('bluetoothctl', 'show', optional=True),
        'outputs': lambda: audio('sinks'), 'inputs': lambda: audio('sources'),
        'output': lambda: command('pactl', 'get-default-sink', optional=True),
        'input': lambda: command('pactl', 'get-default-source', optional=True),
    }
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(probes)) as pool:
        tasks = {name: pool.submit(probe) for name, probe in probes.items()}
        values = {name: task.result() for name, task in tasks.items()}
    bluetooth = values.pop('bluetooth')
    values.update(values.pop('wifi'))
    values.update(bluetoothAvailable='Controller ' in bluetooth, bluetoothEnabled='Powered: yes' in bluetooth,
                  nightAvailable=shutil.which('hyprsunset') is not None,
                  uptime=int(float(Path('/proc/uptime').read_text().split()[0])))
    return values


def apply(request):
    action, value = request.get('action'), request.get('value')
    if isinstance(action, str) and action.startswith('wifi-'):
        desktop_wifi.apply(action, value)
    elif action == 'bluetooth':
        if type(value) is not bool:
            raise ValueError('Expected an on/off value')
        output = command('bluetoothctl', 'power', 'on' if value else 'off')
        if 'succeeded' not in output:
            raise ValueError(output or 'Could not change Bluetooth power')
    elif action in ('volume', 'mute', 'mic', 'output', 'input'):
        if action == 'volume':
            if type(value) not in (int, float) or not 0 <= value <= 100:
                raise ValueError('Volume must be between 0 and 100')
            command('pactl', 'set-sink-volume', '@DEFAULT_SINK@', f'{round(value)}%')
        elif action in ('mute', 'mic'):
            if type(value) is not bool:
                raise ValueError('Expected a mute value')
            command('pactl', 'set-sink-mute' if action == 'mute' else 'set-source-mute',
                    '@DEFAULT_SINK@' if action == 'mute' else '@DEFAULT_SOURCE@', '1' if value else '0')
        else:
            if value not in [item['id'] for item in audio('sinks' if action == 'output' else 'sources')]:
                raise ValueError('This audio device is no longer available')
            command('pactl', 'set-default-sink' if action == 'output' else 'set-default-source', value)
    else:
        raise ValueError('Unknown control action')


def main():
    try:
        request = json.loads(sys.stdin.readline() if sys.argv[1:] == ['--stdin'] else sys.argv[1]) if len(sys.argv) == 2 else {}
        if request.get('action'):
            apply(request)
        print(json.dumps(dict(ok=True, state=snapshot(request.get('device', '')))))
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        print(json.dumps(dict(ok=False, error=str(error))))


if __name__ == '__main__':
    main()
