#!/usr/bin/env python3
"""Generated clocks, lock-screen controls and status; never handles passwords."""
from datetime import datetime
from functools import lru_cache
import json
import math
import os
from pathlib import Path
import pwd
import select
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent


def save_image(image, name, directory=None):
    output = (directory or ROOT / 'theme') / name
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=output.parent, suffix='.png', delete=False) as temporary:
        path = Path(temporary.name)
    try:
        # These are runtime assets: faster lossless encoding saves CPU each tick.
        image.save(path, format='PNG', compress_level=1)
        os.replace(path, output)
    finally:
        path.unlink(missing_ok=True)
    return output


@lru_cache(maxsize=2)
def font_file(style=''):
    preferences = json.loads((ROOT / 'preferences.json').read_text())
    family = preferences.get('font', 'DejaVu Sans')
    return subprocess.check_output(['fc-match', '-f', '%{file}', family + style], text=True).strip()


def lock_clock_image(now=None):
    """Blue cookie dial with hollow hours, pink minutes and separate day/month badges."""
    from PIL import Image, ImageDraw, ImageFont
    now = now or datetime.now()
    scale = 3
    image = Image.new('RGBA', (250 * scale, 260 * scale))
    draw = ImageDraw.Draw(image)
    regular = font_file()
    bold = font_file(':weight=bold')
    face, marks, digits = '#1d438f', '#3357a0', '#6f8bcd'
    hour, minute = '#b2c5ff', '#e4b7f3'
    cx, cy = 123, 132
    def point(x, y):
        return round(x * scale), round(y * scale)
    def ellipse(x, y, radius, color):
        draw.ellipse([point(x - radius, y - radius), point(x + radius, y + radius)], fill=color)
    outline = []
    for step in range(720):
        angle = step * math.tau / 720
        radius = 107 + 6 * math.cos(14 * angle)
        outline.append(point(cx + radius * math.sin(angle), cy - radius * math.cos(angle)))
    draw.polygon(outline, fill=face)
    for index in range(12):
        angle = index * math.tau / 12
        ellipse(cx + 87 * math.sin(angle), cy - 87 * math.cos(angle), 5.5, marks)
    digital_font = ImageFont.truetype(regular, 64 * scale)
    draw.text(point(cx, 99), now.strftime('%H'), font=digital_font, fill=digits, anchor='mm')
    draw.text(point(cx, 165), now.strftime('%M'), font=digital_font, fill=digits, anchor='mm')
    # The hollow hand stays transparent so the digital time is visible through it.
    hand = Image.new('RGBA', image.size)
    hand_draw = ImageDraw.Draw(hand)
    hand_draw.rounded_rectangle([point(cx - 8, cy - 9), point(cx + 60, cy + 9)],
                                radius=9 * scale, outline=hour, width=4 * scale)
    hour_angle = (now.hour % 12 + now.minute / 60) * 30
    hand = hand.rotate(90 - hour_angle, resample=Image.Resampling.BICUBIC, center=point(cx, cy))
    image.alpha_composite(hand)
    draw = ImageDraw.Draw(image)
    angle = now.minute * math.tau / 60
    end = (cx + 83 * math.sin(angle), cy - 83 * math.cos(angle))
    draw.line([point(cx, cy), point(*end)], fill=minute, width=12 * scale)
    ellipse(cx, cy, 6, minute)
    ellipse(*end, 6, minute)
    angle = now.second * math.tau / 60
    end = (cx + 103 * math.sin(angle), cy - 103 * math.cos(angle))
    tail = (cx - 60 * math.sin(angle), cy + 60 * math.cos(angle))
    draw.line([point(*tail), point(*end)], fill=hour, width=scale)
    marker = (cx + 85 * math.sin(angle), cy - 85 * math.cos(angle))
    ellipse(*marker, 2, hour)
    ellipse(cx, cy, 3, face)
    # Rounded pentagon for the day, round badge for the month, matching the reference.
    badge = []
    for index in range(5):
        angle = -math.pi / 2 + index * math.tau / 5
        badge.append((40 + 26 * math.cos(angle), 50 + 26 * math.sin(angle)))
    draw.polygon([point(*vertex) for vertex in badge], fill='#5d386b')
    draw.line([point(*vertex) for vertex in badge + badge[:1]], fill='#5d386b', width=10 * scale)
    for vertex in badge:
        ellipse(*vertex, 5, '#5d386b')
    draw.text(point(40, 50), str(now.day), font=ImageFont.truetype(bold, 28 * scale),
              fill='#f3d9ff', anchor='mm')
    ellipse(206, 214, 31, '#304578')
    draw.text(point(206, 214), str(now.month), font=ImageFont.truetype(regular, 32 * scale),
              fill='#dce3ff', anchor='mm')
    output = save_image(image, 'lock-clock.png')
    return output


def compact_layout(keymap):
    lower = keymap.lower()
    if lower.startswith('english (intl') and 'altgr' in lower:
        return 'US · AltGr'
    if lower.startswith('english (us'):
        if 'euro' in lower:
            return 'US · Euro'
        if 'alt' in lower and ('intl' in lower or 'international' in lower):
            return 'US · AltGr'
        if 'intl' in lower or 'international' in lower:
            return 'US · Intl'
        for variant in ['Dvorak', 'Colemak', 'Workman']:
            if variant.lower() in lower:
                return 'US · ' + variant
        return 'US'
    return {'english (uk)': 'UK', 'spanish': 'ES', 'french': 'FR', 'german': 'DE'}.get(lower, keymap)


def keyboard_layout():
    try:
        result = subprocess.run(['hyprctl', '-j', 'devices'], capture_output=True, text=True,
                                timeout=2, check=True)
        keyboards = json.loads(result.stdout).get('keyboards', [])
        main = next((keyboard for keyboard in keyboards if keyboard.get('main')), {})
        layouts = main.get('layout', '').split(',')
        index = main.get('active_layout_index')
        if isinstance(index, int) and 0 <= index < len(layouts) and layouts[index]:
            variants = main.get('variant', '').split(',')
            variant = variants[index] if index < len(variants) else ''
            suffix = {'euro': 'Euro', 'altgr-intl': 'AltGr', 'intl': 'Intl'}.get(variant, variant)
            return layouts[index].upper() + (' · ' + suffix if suffix else '')
        return compact_layout(main.get('active_keymap') or 'Keyboard')
    except (OSError, ValueError, subprocess.SubprocessError):
        return 'Keyboard'


def pill_image(text, name, icon=None, max_width=None, fixed_width=None, directory=None):
    """Measure text and draw its background/border as one consistently sized widget."""
    from PIL import Image, ImageDraw, ImageFont
    scale, height = 3, 50
    if fixed_width is not None:
        max_width = fixed_width
    path = font_file()
    font_size = 13
    icon_space = 28 if icon else 0
    while True:
        font = ImageFont.truetype(path, font_size * scale)
        text_width = math.ceil(font.getlength(text) / scale)
        width = text_width + 32 + icon_space
        if max_width is None or width <= max_width or font_size <= 10:
            break
        font_size -= 1
    if max_width and width > max_width:
        while text and math.ceil(font.getlength(text + '…') / scale) + 32 + icon_space > max_width:
            text = text[:-1]
        text += '…'
        text_width = math.ceil(font.getlength(text) / scale)
        width = text_width + 32 + icon_space
    if fixed_width is not None:
        width = fixed_width
    image = Image.new('RGBA', (width * scale, height * scale))
    draw = ImageDraw.Draw(image)
    def point(x, y):
        return round(x * scale), round(y * scale)
    ink = '#f0eaff'
    draw.rounded_rectangle([point(1, 1), point(width - 1, height - 1)],
                           radius=24 * scale, fill='#1d293f', outline='#567099', width=scale)
    if icon == 'poweroff':
        draw.arc([point(16, 17), point(32, 33)], -60, 240, fill=ink, width=2 * scale)
        draw.line([point(24, 14), point(24, 24)], fill=ink, width=2 * scale)
    elif icon == 'reboot':
        draw.arc([point(16, 17), point(32, 33)], -65, 240, fill=ink, width=2 * scale)
        draw.polygon([point(16, 14), point(16, 23), point(24, 20)], fill=ink)
    elif icon == 'confirm':
        draw.line([point(17, 25), point(22, 30), point(32, 19)], fill=ink, width=2 * scale)
    elif icon == 'cancel':
        draw.line([point(18, 19), point(30, 31)], fill=ink, width=2 * scale)
        draw.line([point(30, 19), point(18, 31)], fill=ink, width=2 * scale)
    draw.text(point(16 + icon_space, height / 2), text, font=font, fill=ink, anchor='lm')
    output = save_image(image, name, directory)
    return output


def identity_image(username=None, layout=None):
    username = username or pwd.getpwuid(os.getuid()).pw_name
    layout = layout or keyboard_layout()
    output = pill_image(username + '  ·  ' + layout, 'lock-identity.png', max_width=196)
    return output


def prepare():
    lock_clock_image()
    identity_image()
    power_images()


def power_directory(required=False):
    folder = os.environ.get('ARCHSETUP_LOCK_DIR')
    if folder:
        return Path(folder)
    if required:
        raise ValueError('Power controls require a running managed lock screen')
    return ROOT / 'theme'


def power_images(selected=None):
    for action, label, width in [('poweroff', 'Power off', 116), ('reboot', 'Reboot', 104)]:
        icon = action
        if selected is not None:
            label, icon = ('Confirm', 'confirm') if selected == action else ('Cancel', 'cancel')
        output = pill_image(label, f'lock-{action}.png', icon=icon, fixed_width=width,
                            directory=power_directory())
        if selected is None and output.parent != ROOT / 'theme':
            # Only idle buttons enter the persistent cache. Confirmation state
            # stays in the private directory for this lock invocation.
            folder = ROOT / 'theme'
            folder.mkdir(exist_ok=True)
            with tempfile.NamedTemporaryFile(dir=folder, delete=False) as cached:
                temporary = Path(cached.name)
            try:
                temporary.write_bytes(output.read_bytes())
                os.replace(temporary, folder / output.name)
            finally:
                temporary.unlink(missing_ok=True)


def power_action(action):
    subprocess.run([str(ROOT / 'bin/desktop-action'), action], check=True)


class PowerControls:
    def __init__(self, paint=None, execute=None, clock=None):
        self.paint = paint or power_images
        self.execute = execute or power_action
        self.clock = clock or time.monotonic
        self.selected = None
        self.ready_at = 0
        self.executing = False

    def press(self, action):
        if action not in ('poweroff', 'reboot') or self.executing:
            return False
        if self.selected is None:
            self.paint(action)
            self.selected = action
            # Leave a full native image-refresh interval plus loading time before
            # the same button can confirm. The other button can cancel at once.
            self.ready_at = self.clock() + 1.5
            return True
        if action != self.selected:
            self.paint(None)
            self.selected = None
            return True
        if self.clock() < self.ready_at:
            return False
        self.executing = True
        try:
            self.execute(self.selected)
        except (OSError, subprocess.SubprocessError) as error:
            self.paint(None)
            self.selected = None
            self.executing = False
            print(f'Power action failed: {error}', file=sys.stderr)
            return True
        return False


def click_power(action):
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
        client.connect(str(power_directory(required=True) / 'control.sock'))
        client.send({'poweroff': b'p', 'reboot': b'r'}[action])


def receive_power(control):
    data, credentials, flags, _ = control.recvmsg(16, socket.CMSG_SPACE(struct.calcsize('3i')))
    if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
        return None
    for level, kind, value in credentials:
        if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS:
            _, uid, _ = struct.unpack('3i', value)
            if uid == os.getuid():
                return {b'p': 'poweroff', b'r': 'reboot'}.get(data)
    return None


def layout_events():
    """Subscribe before reading the current layout so a switch cannot be missed."""
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        path = Path(os.environ['XDG_RUNTIME_DIR']) / 'hypr' / os.environ['HYPRLAND_INSTANCE_SIGNATURE'] / '.socket2.sock'
        connection.connect(str(path))
        connection.setblocking(False)
        return connection
    except (KeyError, OSError):
        connection.close()
        return None


def watch(parent):
    """Refresh images outside Hyprlock's input loop for this lock invocation only."""
    if parent == 1 or os.getppid() != parent:
        return
    connection = layout_events()
    control = None
    control_path = None
    buttons = PowerControls()
    buffer = b''
    layout = None
    def update_identity():
        nonlocal layout
        current_layout = keyboard_layout()
        if current_layout != layout:
            identity_image(layout=current_layout)
            layout = current_layout
    def stop(*_):
        raise SystemExit(0)
    previous_handler = signal.signal(signal.SIGTERM, stop)
    try:
        if os.environ.get('ARCHSETUP_LOCK_DIR'):
            control_path = power_directory() / 'control.sock'
            control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
            control.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
            control.bind(str(control_path))
            control_path.chmod(0o600)
            power_images()
        update_identity()
        next_clock = time.monotonic()
        # Also stop if the launcher exits unexpectedly, rather than leaving a daemon.
        while os.getppid() == parent:
            started = time.monotonic()
            if started >= next_clock:
                lock_clock_image()
                next_clock = started + 1
                if connection is None:
                    connection = layout_events()
                    buffer = b''
                    update_identity()
            timeout = max(0, next_clock - time.monotonic())
            sockets = [item for item in (connection, control) if item is not None]
            if not sockets:
                time.sleep(timeout)
                continue
            ready = select.select(sockets, [], [], timeout)[0]
            if control is not None and control in ready:
                buttons.press(receive_power(control))
            if connection is None or connection not in ready:
                continue
            try:
                data = connection.recv(65536)
            except OSError:
                data = b''
            if not data:
                connection.close()
                connection = None
                continue
            lines = (buffer + data).split(b'\n')
            buffer = lines.pop()
            # Coalesce a burst and query the main keyboard, ignoring other devices.
            if any(line.startswith(b'activelayout>>') for line in lines):
                update_identity()
    finally:
        signal.signal(signal.SIGTERM, previous_handler)
        if control is not None:
            control.close()
        if control_path is not None:
            control_path.unlink(missing_ok=True)
        if connection is not None:
            connection.close()


def clock_image():
    from PIL import Image, ImageDraw, ImageFont
    now = datetime.now()
    palette = json.loads((ROOT / 'theme/palette.json').read_text())
    scale, size = 3, 230
    image = Image.new('RGBA', (size * scale, size * scale))
    draw = ImageDraw.Draw(image)
    preferences = json.loads((ROOT / 'preferences.json').read_text())
    font_path = subprocess.check_output(['fc-match', '-f', '%{file}',
                                         preferences.get('font', 'DejaVu Sans')], text=True).strip()
    fonts = {}
    def point(x, y):
        return round(x * scale), round(y * scale)
    def font(size):
        if size not in fonts:
            fonts[size] = ImageFont.truetype(font_path, round(size * scale))
        return fonts[size]
    # Fourteen soft scallops, as in the reference cookie-clock silhouette.
    outline = []
    for step in range(720):
        angle = step * math.tau / 720
        radius = 107 + 5 * math.cos(14 * angle)
        outline.append(point(115 + radius * math.sin(angle), 115 - radius * math.cos(angle)))
    draw.polygon(outline, fill=palette['primaryContainer'])
    for number in range(1, 13):
        angle = number * math.tau / 12
        draw.text(point(115 + 89 * math.sin(angle), 115 - 89 * math.cos(angle)),
                  str(number), font=font(13), fill=palette['muted'], anchor='mm')
    draw.text(point(115, 94), now.strftime('%H'), font=font(43), fill=palette['clockText'], anchor='mm')
    draw.text(point(115, 132), now.strftime('%M'), font=font(43), fill=palette['clockText'], anchor='mm')
    # Clock updates are discrete; there are no interpolated hand movements.
    for angle, length, width, color in [
        ((now.hour % 12 + now.minute / 60) * math.tau / 12, 62, 15, palette['accent']),
        (now.minute * math.tau / 60, 87, 9, palette['tertiary'])]:
        end = (115 + length * math.sin(angle), 115 - length * math.cos(angle))
        draw.line([point(115, 115), point(*end)], fill=color, width=width * scale)
        for x, y in [(115, 115), end]:
            radius = width / 2
            draw.ellipse([point(x - radius, y - radius), point(x + radius, y + radius)], fill=color)
    draw.ellipse([point(112, 112), point(118, 118)], fill=palette['primaryContainer'])
    # Day badge is off-center so neither the hands nor digits obscure it.
    draw.rounded_rectangle([point(137, 144), point(180, 175)], radius=12 * scale, fill=palette['raised'])
    draw.text(point(158, 160), str(now.day), font=font(18), fill=palette['ink'], anchor='mm')
    output = ROOT / 'theme/clock.png'
    with tempfile.NamedTemporaryFile(dir=output.parent, suffix='.png', delete=False) as temporary:
        path = Path(temporary.name)
    try:
        image.save(path, format='PNG')
        os.replace(path, output)
    finally:
        path.unlink(missing_ok=True)
    print(output)


def status():
    batteries = [p for p in Path('/sys/class/power_supply').glob('*')
                 if (p / 'type').exists() and (p / 'type').read_text().strip() == 'Battery']
    for battery in batteries:
        if (battery / 'capacity').exists():
            charging = (battery / 'status').exists() and (battery / 'status').read_text().strip() == 'Charging'
            print(('Charging · ' if charging else '') + (battery / 'capacity').read_text().strip() + '%')
            return
    print('')


def capslock():
    result = subprocess.run(['hyprctl', '-j', 'devices'], capture_output=True, text=True, timeout=2)
    if result.returncode == 0:
        devices = json.loads(result.stdout)
        if any(keyboard.get('capsLock') for keyboard in devices.get('keyboards', []) if keyboard.get('main')):
            print('Caps Lock active')
            return
    print('')


if __name__ == '__main__':
    try:
        output = {'clock': clock_image, 'lock-clock': lock_clock_image, 'identity': identity_image,
                  # Ignore a legacy pidfd argument during a partial deployment.
                  # This updater only writes files; it never signals the locker.
                  'prepare': prepare, 'watch': lambda: watch(int(sys.argv[2])),
                  'click-poweroff': lambda: click_power('poweroff'), 'click-reboot': lambda: click_power('reboot'),
                  'status': status, 'capslock': capslock}[sys.argv[1]]()
        if output is not None:
            print(output)
    except (IndexError, KeyError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
