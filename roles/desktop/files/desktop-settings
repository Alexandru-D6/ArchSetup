#!/usr/bin/env python3
"""One JSON request on stdin; one structured JSON response on stdout."""
import json
from pathlib import Path
import subprocess
import sys

from desktop_settings import SettingsError, apply, catalog, clock_snapshot, parse_json, recover, snapshot, sync
import desktop_system as system


def main():
    root = Path(__file__).resolve().parent.parent
    if sys.argv[1:] == ['date']:
        current = clock_snapshot()
        try:
            saved_clock = json.loads((root / 'theme/lock-clock.json').read_text())
            if saved_clock.get('timezone') == current['timezone'] and abs(saved_clock.get('timestamp', 0) - current['timestamp']) < 3:
                current = saved_clock
        except (OSError, ValueError):
            pass
        print(current['date'])
        return 0
    try:
        request = parse_json(sys.stdin.readline(65537))
        if not isinstance(request, dict):
            raise ValueError('Expected a JSON request')
        operation = request.get('operation')
        if operation == 'read':
            result = snapshot(root)
        elif operation == 'apply':
            result = apply(root, request.get('revision'), request.get('changes'))
        elif operation == 'recover':
            result = recover(root)
        elif operation == 'sync':
            changed = sync(root)
            result = snapshot(root)
        elif operation == 'catalog':
            print(json.dumps({'ok': True, 'catalog': catalog()}))
            return 0
        elif operation == 'preview':
            zone = request.get('timezone')
            if not isinstance(zone, str) or zone not in system.timezone_catalog():
                raise SettingsError('validation', 'Choose an installed timezone.')
            print(json.dumps({'ok': True, 'clock': clock_snapshot(zone)}))
            return 0
        else:
            raise SettingsError('request', 'Unknown settings operation.')
        response = {'ok': True, 'snapshot': result}
        if operation == 'sync':
            response['changed'] = changed
    except SettingsError as error:
        response = {'ok': False, 'code': error.code, 'message': str(error), 'fields': error.fields}
        if error.snapshot is not None:
            response['snapshot'] = error.snapshot
    except (ValueError, UnicodeError):
        response = {'ok': False, 'code': 'request', 'message': 'Invalid settings request.'}
    except OSError:
        response = {'ok': False, 'code': 'io', 'message': 'Unable to save or prepare settings. Check the profile files and retry.'}
    except (RuntimeError, subprocess.SubprocessError) as error:
        response = {'ok': False, 'code': 'system', 'message': str(error)}
    print(json.dumps(response, allow_nan=False))
    return 0 if response['ok'] else 1


if __name__ == '__main__':
    sys.exit(main())
