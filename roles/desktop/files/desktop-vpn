#!/usr/bin/env python3
"""JSON interface to selectable VPN providers; native CLIs handle authentication."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

from desktop_vpn import VpnService


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--stdin', action='store_true')
    mode.add_argument('--signin', action='store_true')
    parser.add_argument('--provider')
    args = parser.parse_args()
    service = VpnService(Path(__file__).resolve().parent.parent)
    try:
        if args.signin:
            return service.provider(args.provider or service.selected()).signin()
        request = json.loads(sys.stdin.readline()) if args.stdin else {}
        if args.provider:
            if not isinstance(request, dict):
                raise ValueError('Invalid VPN request.')
            request['provider'] = args.provider
        response = service.request(request)
    except (OSError, ValueError, EOFError, subprocess.SubprocessError) as error:
        if args.signin:
            print(str(error), file=sys.stderr)
            return 1
        response = service.error(error, args.provider or 'proton')
    print(json.dumps(response))
    return 0


if __name__ == '__main__':
    sys.exit(main())
