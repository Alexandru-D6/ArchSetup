#!/usr/bin/env bash
set -euo pipefail
profile="${XDG_CONFIG_HOME:-$HOME/.config}/archsetup"
[[ -r "$profile/hyprland.lua" ]] || { echo 'Provision the ArchSetup desktop for this account first.' >&2; exit 1; }
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
# Generate colors before Hyprland reads its Lua, including the first boot.
"$profile/bin/desktop-action" refresh-theme
args=(--config "$profile/hyprland.lua")
case "${1:-}" in
  --locked)
    # Lock within the compositor's startup path, before desktop interaction.
    printf -v locker '%q lock' "$profile/bin/desktop-action"
    args+=(--locked-cmd "$locker")
    ;;
  '') ;;
  *) echo 'Usage: archsetup-session [--locked]' >&2; exit 2 ;;
esac
exec start-hyprland -- "${args[@]}"
