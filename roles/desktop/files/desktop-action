#!/usr/bin/env python3
"""Desktop actions use argument arrays; clipboard/window data is never shell code."""
import ast
import colorsys
import fcntl
import hashlib
import operator
import json
import os
import random
import select
import signal
import shutil
import socket
import struct
import tempfile
import threading
from pathlib import Path
import subprocess
import sys
from datetime import datetime

ROOT = Path(__file__).resolve().parent.parent

def run(*args, **kwargs):
    if args and args[0] == 'wl-copy':
        # The clipboard owner remains alive after copying. Do not retain the
        # invoking helper's output streams (including remote validation pipes).
        kwargs.setdefault('stdout', subprocess.DEVNULL)
        kwargs.setdefault('stderr', subprocess.DEVNULL)
    return subprocess.run(args, check=True, **kwargs)

def capture(*args):
    return run(*args, stdout=subprocess.PIPE, text=True).stdout

def themed(name):
    generated = ROOT / 'theme' / name
    base = ROOT / name
    # A newly deployed template may contain authentication changes. Do not use
    # an older generated copy while session startup is still rebuilding themes.
    return generated if generated.exists() and generated.stat().st_mtime_ns >= base.stat().st_mtime_ns else base

def calculate(expression):
    if len(expression) > 200: raise ValueError('Expression is too long')
    operations = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
                  ast.Div: operator.truediv, ast.Mod: operator.mod, ast.Pow: operator.pow}
    def visit(node, depth=0):
        if depth > 20: raise ValueError('Expression is too deeply nested')
        if isinstance(node, ast.Constant) and type(node.value) in (int, float): result = node.value
        elif isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
            result = visit(node.operand, depth + 1) * (-1 if isinstance(node.op, ast.USub) else 1)
        elif isinstance(node, ast.BinOp) and type(node.op) in operations:
            left, right = visit(node.left, depth + 1), visit(node.right, depth + 1)
            if isinstance(node.op, ast.Pow) and abs(right) > 100: raise ValueError('Exponent too large')
            result = operations[type(node.op)](left, right)
        else: raise ValueError('Use numbers and arithmetic operators only')
        if type(result) not in (int, float) or abs(result) > 1e100: raise ValueError('Result out of range')
        return result
    return visit(ast.parse(expression, mode='eval').body)

def atomic_write(path, text):
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temporary:
        temporary.write(text)
    os.replace(temporary.name, path)

def write_wallpaper(folder, state, palette):
    """Use a personal image, or draw an original gradient without bundled artwork."""
    from PIL import Image, ImageColor, ImageDraw
    wallpaper = Path(state['wallpaper']) if state.get('wallpaper') else None
    with tempfile.NamedTemporaryFile(dir=folder, suffix='.png', delete=False) as temporary:
        path = Path(temporary.name)
    try:
        if wallpaper is not None and wallpaper.is_file():
            path.write_bytes(wallpaper.read_bytes())
        else:
            background = Image.new('RGB', (1280, 720))
            draw = ImageDraw.Draw(background)
            top = ImageColor.getrgb(palette['wallpaperTop'])
            bottom = ImageColor.getrgb(palette['wallpaperBottom'])
            for row in range(background.height):
                fraction = row / (background.height - 1)
                color = tuple(round(a + (b - a) * fraction) for a, b in zip(top, bottom))
                draw.line((0, row, background.width, row), fill=color)
            background.save(path, format='PNG')
        os.replace(path, folder / 'wallpaper.png')
    finally:
        path.unlink(missing_ok=True)

def appearance(state):
    presets = json.loads((ROOT / 'themes.json').read_text())
    preferences = json.loads((ROOT / 'preferences.json').read_text())
    name = state.get('theme', preferences.get('defaultTheme', 'rose'))
    if name not in presets:
        raise ValueError(f'Unknown color theme: {name}')
    preset = presets[name]
    light = state.get('light', preset['defaultLight']) is True
    palette = dict(preset['light' if light else 'dark'], theme=name, name=preset['name'], light=light)
    if preset['wallpaperAccent'] and state.get('wallpaper'):
        try:
            from PIL import Image
            with Image.open(state['wallpaper']) as image:
                image.thumbnail((64, 64))
                r, g, b = image.convert('RGB').resize((1, 1)).getpixel((0, 0))
            hue, _, saturation = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
            rgb = colorsys.hls_to_rgb(hue, 0.40 if light else 0.77, min(0.65, max(0.3, saturation)))
            palette['accent'] = '#' + ''.join(f'{round(channel * 255):02x}' for channel in rgb)
        except (ImportError, OSError, ValueError):
            pass  # A missing wallpaper uses the fixed, readable fallback palette.
    return palette

def refresh_theme(state):
    palette = appearance(state)
    state['accent'] = palette['accent']
    colors = {original: palette[token].removeprefix('#') for original, token in {
        '191620': 'surface', '292332': 'raised', 'eae0f5': 'ink',
        '45404f': 'outline', 'c4a7e7': 'accent', 'ffffff': 'onAccent'}.items()}
    folder = ROOT / 'theme'
    folder.mkdir(exist_ok=True)
    atomic_write(folder / 'palette.json', json.dumps(palette) + '\n')
    # Fixed local paths keep personal filenames out of config and shell commands.
    write_wallpaper(folder, state, palette)
    configurations = ['fuzzel.ini', 'swaync.css', 'hyprlock.conf', 'kitty.conf']
    if (ROOT / 'lock-identity.conf').exists(): configurations.append('lock-identity.conf')
    for name in configurations:
        lines = (ROOT / name).read_text().splitlines(keepends=True)
        for index, line in enumerate(lines):
            # Native lock labels contain usernames/layouts. Color substitutions
            # must leave their text and the configuration's file paths intact.
            if name in ('hyprlock.conf', 'lock-identity.conf') and line.partition('=')[0].strip() not in (
                    'color', 'border_color', 'outer_color', 'inner_color', 'font_color'):
                continue
            for original, replacement in colors.items(): line = line.replace(original, replacement)
            lines[index] = line
        content = ''.join(lines)
        if name == 'hyprlock.conf' and 'lock-identity.conf' in configurations:
            content = content.replace(str(ROOT / 'lock-identity.conf'), str(folder / 'lock-identity.conf'))
        atomic_write(folder / name, content)
    atomic_write(folder / 'colors.lua', 'hl.config({general={col={active_border="rgba(' + colors['c4a7e7'] + 'bb)",inactive_border="rgba(' + colors['45404f'] + '55)"}}})\n')
    atomic_write(ROOT / 'state.json', json.dumps(state) + '\n')

def close_popup(path):
    # The owning helper controls its own child. Never signal a PID read from disk.
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(3)
            connection.connect(str(path))
            connection.sendall(b'close\n')
            response = json.loads(connection.makefile('r').readline(512))
            if response.get('error'): raise ValueError(response['error'])
            return response.get('name')
    except (FileNotFoundError, ConnectionRefusedError, json.JSONDecodeError):
        return None

def control_popup(listener, descriptor, name, stopped):
    while not stopped.is_set():
        try:
            connection, _ = listener.accept()
        except socket.timeout:
            continue
        except OSError:
            return
        with connection:
            connection.settimeout(2)
            try:
                credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
                if struct.unpack('3i', credentials)[1] != os.getuid(): continue
                if connection.makefile('rb').readline(32) != b'close\n': continue
                response = {'name': None}
                if not select.select([descriptor], [], [], 0)[0]:
                    signal.pidfd_send_signal(descriptor, signal.SIGTERM)
                    if select.select([descriptor], [], [], 2)[0]: response['name'] = name
                    else: response = {'error': 'The popup is still closing; try the shortcut again.'}
                connection.sendall((json.dumps(response) + '\n').encode())
            except (OSError, ValueError):
                continue

def popup(name, args, *, input=None, **kwargs):
    signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE')
    if not signature: raise ValueError('Desktop popups must run inside Hyprland')
    namespace = 'archsetup-popup-' + hashlib.sha256((signature + str(ROOT)).encode()).hexdigest()[:16]
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    path = runtime / (namespace + '.json')
    socket_path = runtime / (namespace + '.sock')
    guard_path = runtime / (namespace + '.lock')
    args = [*args, '--namespace=' + namespace]
    with guard_path.open('a') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        if close_popup(socket_path) == name:
            return subprocess.CompletedProcess(args, 2, '' if kwargs.get('text') else b'')
        socket_path.unlink(missing_ok=True)
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        child = None
        descriptor = None
        try:
            listener.bind(str(socket_path))
            socket_path.chmod(0o600)
            listener.listen(1)
            listener.settimeout(0.2)
            child = subprocess.Popen(args, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL, **kwargs)
            # This descriptor pins the child we just created, without /proc access.
            descriptor = os.pidfd_open(child.pid)
            state = {'pid': child.pid, 'owner': os.getpid(), 'name': name, 'token': os.urandom(16).hex()}
            atomic_write(path, json.dumps(state) + '\n')
        except BaseException:
            listener.close()
            socket_path.unlink(missing_ok=True)
            if child is not None:
                child.terminate()
                child.wait()
            if descriptor is not None: os.close(descriptor)
            raise
    stopped = threading.Event()
    controller = threading.Thread(target=control_popup, args=(listener, descriptor, name, stopped), daemon=True)
    controller.start()
    try:
        stdout, stderr = child.communicate(input)
        return subprocess.CompletedProcess(args, child.returncode, stdout, stderr)
    finally:
        stopped.set()
        listener.close()
        controller.join()
        os.close(descriptor)
        with guard_path.open('a') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            try:
                if json.loads(path.read_text()) == state:
                    path.unlink()
                    socket_path.unlink(missing_ok=True)
            except (OSError, ValueError): pass

def menu(lines, prompt):
    result = popup(prompt, ['fuzzel', '--config', str(themed('fuzzel.ini')),
                            '--dmenu', '--prompt', prompt + ': '],
                   input='\n'.join(lines), text=True, stdout=subprocess.PIPE)
    if result.returncode != 0:
        return None
    return result.stdout.rstrip('\n')

def media_directory(kind):
    try:
        folder = Path(capture('xdg-user-dir', kind).strip())
        if not folder.is_absolute(): raise ValueError('Invalid media path')
        configuration = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'user-dirs.dirs'
        if folder == Path.home() and not configuration.exists(): raise ValueError('Unconfigured media path')
    except (ValueError, OSError, subprocess.CalledProcessError):
        folder = Path.home() / ('Videos' if kind == 'VIDEOS' else 'Pictures')
    return folder

def screenshot(action):
    args = ['grim']
    if action in ('screenshot', 'screenshot-region-save', 'ocr'):
        region = subprocess.run(['slurp'], text=True, stdout=subprocess.PIPE)
        if region.returncode: return
        args += ['-g', region.stdout.strip()]
    elif action in ('screenshot-monitor', 'screenshot-save'):
        monitor = next((m['name'] for m in json.loads(capture('hyprctl', '-j', 'monitors')) if m.get('focused')), None)
        if not monitor: raise ValueError('No focused monitor')
        args += ['-o', monitor]
    data = run(*args, '-', stdout=subprocess.PIPE, timeout=10).stdout
    if action == 'ocr':
        language = json.loads((ROOT / 'preferences.json').read_text()).get('ocrLanguage', 'eng')
        result = run('tesseract', 'stdin', 'stdout', '-l', language, input=data, stdout=subprocess.PIPE, timeout=30).stdout
        run('wl-copy', input=result)
        run('notify-send', 'Text copied', 'Recognized text is on the clipboard.')
        return
    run('wl-copy', '--type', 'image/png', input=data)
    if action in ('screenshot-save', 'screenshot-region-save'):
        folder = media_directory('PICTURES') / 'Screenshots'
        folder.mkdir(parents=True, exist_ok=True)
        path = folder / ('Screenshot_' + datetime.now().strftime('%Y-%m-%d_%H-%M-%S_%f') + '.png')
        path.write_bytes(data)
        run('notify-send', 'Screenshot saved and copied', str(path))
    else:
        run('notify-send', 'Screenshot copied', 'Paste it into an application to save or share.')

def shell_toggle(name):
    run('qs', '-p', str(ROOT / 'shell'), 'ipc', 'call', 'desktop', 'control', name)

def main(action):
    if action == 'terminal': run('kitty', '--config', str(themed('kitty.conf')))
    elif action == 'files': run('thunar')
    elif action == 'browser':
        preferences = json.loads((ROOT / 'preferences.json').read_text())
        run('gtk-launch', preferences['browser'])
    elif action in ('code-editor', 'text-editor', 'office'):
        field = {'code-editor': 'codeEditor', 'text-editor': 'textEditor', 'office': 'office'}[action]
        run('gtk-launch', json.loads((ROOT / 'preferences.json').read_text())[field])
    elif action == 'task-manager': run('kitty', '--config', str(themed('kitty.conf')), '-e', 'btop')
    elif action == 'edit-shortcuts':
        path = ROOT / 'overrides.lua'
        if not path.exists(): path.write_text('-- Personal Hyprland overrides and additional bindings.\n')
        run('gtk-launch', json.loads((ROOT / 'preferences.json').read_text())['codeEditor'], str(path))
    elif action == 'launcher': popup('launcher', ['fuzzel', '--config', str(themed('fuzzel.ini'))])
    elif action == 'lock':
        signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
        if not signature: raise ValueError('Lock must run inside a Hyprland session')
        suffix = hashlib.sha256(signature.encode()).hexdigest()[:16]
        lockfile = Path(os.environ['XDG_RUNTIME_DIR']) / ('archsetup-lock-' + suffix)
        with lockfile.open('w') as descriptor:
            try: fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError: return
            recorder = ROOT / 'bin/desktop-record'
            if recorder.exists(): run(str(recorder), 'record-stop')
            # Each lock owns its button labels and control socket. Pending clicks
            # and confirmation labels cannot carry over to a later lock session.
            with tempfile.TemporaryDirectory(prefix='archsetup-lock-', dir=os.environ['XDG_RUNTIME_DIR']) as lock_dir:
                environment = dict(os.environ, ARCHSETUP_LOCK_DIR=lock_dir)
                # Default labels are ready before locking; the decorative clock
                # is generated afterward without delaying password input.
                for power, label in [('poweroff', 'Power off'), ('reboot', 'Reboot')]:
                    (Path(lock_dir) / f'lock-{power}.label').write_text(label + '\n')
                configuration = themed('hyprlock.conf').read_text()
                for power in ('poweroff', 'reboot'):
                    configuration = configuration.replace(str(ROOT / f'theme/lock-{power}.label'),
                                                          str(Path(lock_dir) / f'lock-{power}.label'))
                config_path = Path(lock_dir) / 'hyprlock.conf'
                config_path.write_text(configuration)
                arguments = ['hyprlock', '-c', str(config_path)]
                # Hyprlock 0.9.6 runs unsafe timer callbacks in its SIGUSR2
                # handler. Native image timers replace that refresh path. Block
                # the signal before exec so every locker thread inherits the
                # mask, including during startup and cleanup; restore our mask.
                previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGUSR2})
                try:
                    locker = subprocess.Popen(arguments, env=environment)
                finally:
                    signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
                updater = None
                try:
                    try:
                        updater = subprocess.Popen([str(ROOT / 'bin/lock-visuals'), 'watch', str(os.getpid())],
                                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                                   env=environment)
                    except OSError as error:
                        # Visual-helper failures must leave the password screen running.
                        print(f'Lock image updater unavailable: {error}', file=sys.stderr)
                    result = locker.wait()
                    if result:
                        raise subprocess.CalledProcessError(result, arguments)
                finally:
                    if updater is not None:
                        updater.terminate()
                        try:
                            updater.wait(timeout=3)
                        except subprocess.TimeoutExpired:
                            updater.kill()
                            updater.wait()
    elif action in ('overview', 'settings', 'session', 'tools', 'media'):
        run('qs', '-p', str(ROOT / 'shell'), 'ipc', 'call', 'desktop', 'toggle', action)
    elif action in ('keyboard', 'widgets', 'bar', 'bar-position', 'detach-tools'):
        shell_toggle(action)
    elif action == 'restart-shell':
        run('qs', '-p', str(ROOT / 'shell'), 'kill')
        # session-services supervises only this profile's qs instance and restarts it.
    elif action == 'kill-window': run('hyprctl', 'kill')
    elif action.startswith('record-'):
        run(str(ROOT / 'bin/desktop-record'), action)
    elif action == 'notifications': run('swaync-client', '-t')
    elif action == 'dnd': run('swaync-client', '-d')
    elif action == 'audio': run('pavucontrol')
    elif action == 'network': run('nm-connection-editor')
    elif action == 'bluetooth': run('blueman-manager')
    elif action == 'color': run('hyprpicker', '-a')
    elif action == 'clipboard':
        selection = menu(['[Clear history]'] + capture('cliphist', 'list').splitlines(), 'Clipboard')
        if selection == '[Clear history]':
            run('cliphist', 'wipe')
        elif selection:
            data = run('cliphist', 'decode', input=selection.encode(), stdout=subprocess.PIPE).stdout
            run('wl-copy', input=data)
    elif action == 'emoji':
        selection = menu(['😀 Smile', '❤️ Heart', '👍 Yes', '🎉 Celebrate', '✅ Done', '🔥 Fire', '🤔 Thinking', '🚀 Rocket'], 'Emoji')
        if selection: run('wl-copy', selection.split(' ')[0])
    elif action in ('screenshot', 'screenshot-full', 'screenshot-monitor', 'screenshot-save', 'screenshot-region-save', 'ocr'):
        screenshot(action)
    elif action == 'calculator':
        expression = menu([], 'Calculate')
        if expression:
            try:
                value = str(calculate(expression))
                run('wl-copy', value)
                run('notify-send', 'Result copied', value)
            except (ValueError, SyntaxError, ZeroDivisionError, OverflowError) as error:
                run('notify-send', 'Calculation failed', str(error))
    elif action == 'refresh-theme':
        path = ROOT / 'state.json'
        refresh_theme(json.loads(path.read_text()) if path.exists() else {})
    elif action == 'status':
        def probe(*args):
            try:
                return subprocess.run(args, capture_output=True, text=True, timeout=2).stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                return ''
        volume = probe('wpctl', 'get-volume', '@DEFAULT_AUDIO_SINK@')
        network = probe('nmcli', '-t', '-f', 'STATE', 'general')
        media = probe('playerctl', 'metadata', '--format', '{{artist}} — {{title}}')
        firmware = probe('busctl', '--timeout=1', 'call', 'org.freedesktop.login1',
                         '/org/freedesktop/login1', 'org.freedesktop.login1.Manager', 'CanRebootToFirmwareSetup')
        print(json.dumps(dict(volume=volume.removeprefix('Volume: ') or 'No audio', network=network or 'Disconnected', media=media,
                              canFirmwareSetup=firmware in ('s "yes"', 's "challenge"'),
                              brightness=any(Path('/sys/class/backlight').glob('*')))))
    elif action in ('theme', 'theme-select', 'wallpaper', 'wallpaper-random'):
        path = ROOT / 'state.json'
        state = json.loads(path.read_text()) if path.exists() else {}
        if action == 'theme':
            state['light'] = not appearance(state)['light']
        elif action == 'theme-select':
            presets = json.loads((ROOT / 'themes.json').read_text())
            selected = menu([preset['name'] for preset in presets.values()], 'Color theme')
            if selected is None: return
            name = next((name for name, preset in presets.items() if preset['name'] == selected), None)
            if name is None: raise ValueError('Select an available color theme')
            state['theme'] = name
            state['light'] = presets[name]['defaultLight']
        else:
            folder = Path.home() / 'Pictures' / 'Wallpapers'
            files = sorted(str(p) for p in folder.glob('*') if p.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp'))
            if action == 'wallpaper-random' and not files:
                run('notify-send', 'No wallpapers found', str(folder))
                return
            selected = random.choice(files) if action == 'wallpaper-random' else menu(['[Default background]'] + files, 'Wallpaper')
            if selected is None: return
            state['wallpaper'] = '' if selected == '[Default background]' else selected
        refresh_theme(state)
        subprocess.run(['swaync-client', '-rs'], check=False)
        subprocess.run(['hyprctl', 'reload'], check=False)
    elif action == 'help':
        bindings = json.loads((ROOT / 'shortcuts.json').read_text())
        menu([f"{item['key']}  —  {item['description']}" for item in bindings], 'Shortcuts')
    elif action == 'poweroff':
        run('qs', '-p', str(ROOT / 'shell'), 'ipc', 'call', 'desktop', 'shutdown')
    elif action == 'firmware-setup':
        run('systemctl', 'reboot', '--firmware-setup')
    elif action in ('logout', 'reboot', 'poweroff-confirmed', 'suspend', 'hibernate'):
        if action == 'logout': run('hyprctl', 'dispatch', 'hl.dsp.exit()')
        else:
            # Hypridle's sleep inhibitor locks before the system sleeps.
            run('systemctl', 'poweroff' if action == 'poweroff-confirmed' else action)
    else:
        raise ValueError(f'Unknown action: {action}')

if __name__ == '__main__':
    try:
        if len(sys.argv) != 2: raise ValueError('Usage: desktop-action ACTION')
        main(sys.argv[1])
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
