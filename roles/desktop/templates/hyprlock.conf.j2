general {
    hide_cursor = false
    immediate_render = true
}
auth {
    pam:enabled = true
    pam:module = archsetup-hyprlock
}
animations {
    enabled = {{ (not (archsetup_desktop_reduced_motion | bool)) | to_json }}
    bezier = archsetupSharp, 0.16, 1, 0.3, 1
    # Hyprlock 0.9.6 requires whole deciseconds; fades/colors take 100 ms.
    animation = global, 1, 1, archsetupSharp
    animation = fadeIn, 1, 1, archsetupSharp
    animation = fadeOut, 1, 1, archsetupSharp
    animation = inputField, 1, 1, archsetupSharp
    animation = inputFieldColors, 1, 1, archsetupSharp
    # Keystrokes need immediate visual feedback even with other animations on.
    animation = inputFieldDots, 0
}
background {
    monitor =
    path = {{ desktop_root }}/assets/lock-wallpaper.jpg
    color = rgba(0b1422ff)
    blur_passes = 0
    noise = 0
    contrast = 1
    brightness = 1
}
# A light tint preserves the wallpaper's detail while keeping labels readable.
shape {
    monitor =
    size = 100%, 100%
    color = rgba(07112026)
    rounding = 0
    border_size = 0
    position = 0, 0
    halign = center
    valign = center
    zindex = 0
}
image {
    monitor =
    path = {{ desktop_root }}/theme/lock-clock.png
    size = 250
    rounding = 0
    border_size = 0
    # The lock launcher updates this file in the background. Image reload_cmd
    # runs synchronously in Hyprlock and would stall password input every tick.
    reload_time = 0
    position = 0, 0
    halign = center
    valign = center
    zindex = 1
}
label {
    monitor =
    text = Locked
    color = rgba(f0eaffff)
    font_size = 11
    font_family = {{ archsetup_desktop_font }}
    position = 0, -160
    halign = center
    valign = center
    zindex = 1
}
label {
    monitor =
    text = cmd[update:60000] date +"%A, %B %-d"
    color = rgba(f0eaffff)
    font_size = 12
    font_family = {{ archsetup_desktop_font }}
    position = 0, -188
    halign = center
    valign = center
    zindex = 1
}
# Text and border share one measured image, so layout changes resize the pill.
# Layout events refresh it immediately through Hyprlock's SIGUSR2 image reload.
image {
    monitor =
    path = {{ desktop_root }}/theme/lock-identity.png
    size = 50
    rounding = 0
    border_size = 0
    reload_time = 0
    position = -270, 20
    halign = center
    valign = bottom
    zindex = 1
}
input-field {
    monitor =
    size = 320, 50
    fade_on_empty = false
    outline_thickness = 1
    dots_size = 0.18
    dots_spacing = 0.25
    outer_color = rgba(567099ff)
    inner_color = rgba(1d293fff)
    font_color = rgba(f0eaffff)
    placeholder_text = Enter password
    fail_text = Authentication failed
    font_family = {{ archsetup_desktop_font }}
    rounding = 25
    position = 0, 20
    halign = center
    valign = bottom
    zindex = 1
}
image {
    monitor =
    path = {{ desktop_root }}/theme/lock-poweroff.png
    size = 50
    rounding = 0
    border_size = 0
    reload_time = 0
    position = 230, 20
    halign = center
    valign = bottom
    zindex = 1
    onclick = {{ desktop_root }}/bin/lock-visuals click-poweroff
}
image {
    monitor =
    path = {{ desktop_root }}/theme/lock-reboot.png
    size = 50
    rounding = 0
    border_size = 0
    reload_time = 0
    position = 346, 20
    halign = center
    valign = bottom
    zindex = 1
    onclick = {{ desktop_root }}/bin/lock-visuals click-reboot
}
label {
    monitor =
    text = cmd[update:1000] {{ desktop_root }}/bin/lock-visuals capslock
    color = rgba(f0eaffff)
    font_size = 10
    font_family = {{ archsetup_desktop_font }}
    position = 0, 82
    halign = center
    valign = bottom
    zindex = 1
}
label {
    monitor =
    text = cmd[update:5000] {{ desktop_root }}/bin/lock-visuals status
    color = rgba(f0eaffff)
    font_size = 11
    font_family = {{ archsetup_desktop_font }}
    position = 24, -24
    halign = left
    valign = top
    zindex = 1
}
