general {
    hide_cursor = false
    immediate_render = true
}
auth {
    pam:enabled = true
    pam:module = archsetup-hyprlock
}
animations {
    enabled = {{ (not (archsetup_desktop_reduced_motion | bool)) | to_json }}
    bezier = archsetupSharp, 0.16, 1, 0.3, 1
    # Hyprlock 0.9.6 requires whole deciseconds; fades/colors take 100 ms.
    animation = global, 1, 1, archsetupSharp
    animation = fadeIn, 1, 1, archsetupSharp
    animation = fadeOut, 1, 1, archsetupSharp
    animation = inputField, 1, 1, archsetupSharp
    animation = inputFieldColors, 1, 1, archsetupSharp
    # Keystrokes need immediate visual feedback even with other animations on.
    animation = inputFieldDots, 0
}
background {
    monitor =
    path = {{ desktop_root }}/assets/lock-wallpaper.jpg
    color = rgba(0b1422ff)
    blur_passes = 0
    noise = 0
    contrast = 1
    brightness = 1
}
# A light tint preserves the wallpaper's detail while keeping labels readable.
shape {
    monitor =
    size = 100%, 100%
    color = rgba(07112026)
    rounding = 0
    border_size = 0
    position = 0, 0
    halign = center
    valign = center
    zindex = 0
}
# archsetup-lock-clock-start
image {
    monitor =
    path = {{ desktop_root }}/theme/lock-clock.png
    size = 250
    rounding = 0
    border_size = 0
    # The lock launcher updates this file in the background. Image reload_cmd
    # runs synchronously in Hyprlock and would stall password input every tick.
    # Positive intervals run on the normal event loop, without SIGUSR2 callbacks.
    reload_time = 1
    position = 0, 0
    halign = center
    valign = center
    zindex = 1
}
label {
    monitor =
    text = Locked
    color = rgba(f0eaffff)
    font_size = {{ archsetup_desktop_control_font_size | int }}
    font_family = {{ archsetup_desktop_font }}
    position = 0, -160
    halign = center
    valign = center
    zindex = 1
}
label {
    monitor =
    text = cmd[update:1000] "{{ desktop_root }}/bin/desktop-settings" date
    color = rgba(f0eaffff)
    font_size = {{ archsetup_desktop_control_font_size | int }}
    font_family = {{ archsetup_desktop_font }}
    position = 0, -188
    halign = center
    valign = center
    zindex = 1
}
# archsetup-lock-clock-end
# A measured native label reacts to Wayland layout changes without image polling.
source = {{ desktop_root }}/lock-identity.conf
input-field {
    monitor =
    size = 320, 50
    fade_on_empty = false
    outline_thickness = 1
    dots_size = 0.18
    dots_spacing = 0.25
    outer_color = rgba(45404fff)
    inner_color = rgba(292332ff)
    font_color = rgba(eae0f5ff)
    # Hyprlock sizes input text from the field height; markup fixes its point size.
    placeholder_text = <span size="{{ (archsetup_desktop_control_font_size | int) * 1024 }}">Enter password</span>
    fail_text = <span size="{{ (archsetup_desktop_control_font_size | int) * 1024 }}">Authentication failed</span>
    font_family = {{ archsetup_desktop_font }}
    rounding = 25
    position = 0, 20
    halign = center
    valign = bottom
    zindex = 1
}
# archsetup-lock-power-start
{% if not (archsetup_desktop_lock_require_auth_for_power | bool) %}{% include 'lock-power.conf.j2' %}{% endif %}
# archsetup-lock-power-end
label {
    monitor =
    text = cmd[update:1000] {{ desktop_root }}/bin/lock-visuals capslock
    color = rgba(f0eaffff)
    font_size = {{ archsetup_desktop_control_font_size | int }}
    font_family = {{ archsetup_desktop_font }}
    position = 0, 82
    halign = center
    valign = bottom
    zindex = 1
}
label {
    monitor =
    text = cmd[update:5000] {{ desktop_root }}/bin/lock-visuals status
    color = rgba(f0eaffff)
    font_size = {{ archsetup_desktop_control_font_size | int }}
    font_family = {{ archsetup_desktop_font }}
    position = 24, -24
    halign = left
    valign = top
    zindex = 1
}
