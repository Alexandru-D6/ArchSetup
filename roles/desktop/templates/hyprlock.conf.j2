general {
    hide_cursor = true
}
animations {
    enabled = {{ (not (archsetup_desktop_reduced_motion | bool)) | to_json }}
}
background {
    monitor =
    color = rgba(191620ff)
}
label {
    monitor =
    text = $TIME
    color = rgba(eae0f5ff)
    font_size = 64
    font_family = DejaVu Sans
    position = 0, 130
    halign = center
    valign = center
}
input-field {
    monitor =
    size = 320, 60
    fade_on_empty = false
    outline_thickness = 2
    outer_color = rgba(c4a7e7ff)
    inner_color = rgba(292332ff)
    font_color = rgba(eae0f5ff)
    placeholder_text = Enter password
    fail_text = Authentication failed
    rounding = 16
    position = 0, -40
    halign = center
    valign = center
}
