-- Managed by ArchSetup. Personal overrides live in overrides.lua beside this file.
local root = {{ desktop_root | to_json }}
local action = root .. "/bin/desktop-action"
{% for monitor in archsetup_desktop_monitors %}
hl.monitor({
{% for key, value in monitor.items() %}
    {{ key }} = {{ value | to_json }},
{% endfor %}
})
{% endfor %}
hl.config({
    input = {
{% for key, value in archsetup_desktop_input.items() if key != 'touchpad' %}
        {{ key }} = {{ value | to_json }},
{% endfor %}
        touchpad = {
{% for key, value in archsetup_desktop_input.touchpad.items() %}
            {{ key }} = {{ value | to_json }},
{% endfor %}
        },
    },
    general = { gaps_in = 4, gaps_out = 5, border_size = 1, layout = "dwindle",
        col = { active_border = "rgba(c4a7e7ff)", inactive_border = "rgba(45404fff)" } },
    decoration = { rounding = 18, rounding_power = 2.5,
        blur = { enabled = true, size = 10, passes = 3 },
        shadow = { enabled = true, range = 20, render_power = 10, color = "rgba(00000020)" },
        dim_inactive = true, dim_strength = 0.05 },
    animations = { enabled = {{ (not (archsetup_desktop_reduced_motion | bool)) | to_json }} },
    dwindle = { preserve_split = true },
    misc = { disable_hyprland_logo = true, disable_splash_rendering = true,
        on_focus_under_fullscreen = 2, exit_window_retains_fullscreen = false },
})
-- Speeds are deciseconds: 80–140 ms, with a sharp ease-out and no overshoot.
hl.curve("archsetupSharp", { type = "bezier", points = { {0.16, 1}, {0.3, 1} } })
hl.animation({ leaf = "global", enabled = true, speed = 1, bezier = "archsetupSharp" })
hl.animation({ leaf = "windows", enabled = true, speed = 1.2, bezier = "archsetupSharp", style = "popin 98%" })
hl.animation({ leaf = "windowsIn", enabled = true, speed = 1.2, bezier = "archsetupSharp", style = "popin 98%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 0.8, bezier = "archsetupSharp", style = "popin 98%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = 1, bezier = "archsetupSharp" })
hl.animation({ leaf = "fade", enabled = true, speed = 0.8, bezier = "archsetupSharp" })
hl.animation({ leaf = "fadeIn", enabled = true, speed = 0.8, bezier = "archsetupSharp" })
hl.animation({ leaf = "fadeOut", enabled = true, speed = 0.8, bezier = "archsetupSharp" })
hl.animation({ leaf = "border", enabled = true, speed = 0.8, bezier = "archsetupSharp" })
hl.animation({ leaf = "borderangle", enabled = false })
hl.animation({ leaf = "layers", enabled = true, speed = 1, bezier = "archsetupSharp", style = "fade" })
hl.animation({ leaf = "layersIn", enabled = true, speed = 1, bezier = "archsetupSharp", style = "fade" })
hl.animation({ leaf = "layersOut", enabled = true, speed = 0.8, bezier = "archsetupSharp", style = "fade" })
hl.animation({ leaf = "fadeLayersIn", enabled = true, speed = 0.8, bezier = "archsetupSharp" })
hl.animation({ leaf = "fadeLayersOut", enabled = true, speed = 0.8, bezier = "archsetupSharp" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 1.4, bezier = "archsetupSharp", style = "slidefade 12%" })
hl.animation({ leaf = "workspacesIn", enabled = true, speed = 1.4, bezier = "archsetupSharp", style = "slidefade 12%" })
hl.animation({ leaf = "workspacesOut", enabled = true, speed = 1.4, bezier = "archsetupSharp", style = "slidefade 12%" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 1.2, bezier = "archsetupSharp", style = "slidefade 12%" })
hl.animation({ leaf = "zoomFactor", enabled = true, speed = 1, bezier = "archsetupSharp" })
-- Let the layout arrange new terminals; fullscreen remains an explicit shortcut.
hl.window_rule({
    name = "archsetup-terminal-tiling",
    match = { class = "^kitty$" },
    tile = true,
    fullscreen_state = "0 0",
    suppress_event = "maximize fullscreen",
})
hl.env("XCURSOR_SIZE", "24")
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.on("hyprland.start", function() hl.exec_cmd(root .. "/bin/session-services") end)
-- Native callbacks only: never run blocking external work on the compositor loop.
local callbacks = {}
local function zoom(delta)
    local value = tonumber(hl.get_config("cursor:zoom_factor")) or 1
    hl.config({cursor={zoom_factor=math.max(1, math.min(3, value + delta))}})
end
callbacks["zoom-in"] = function() zoom(0.3) end
callbacks["zoom-out"] = function() zoom(-0.3) end
callbacks["zoom-reset"] = function() hl.config({cursor={zoom_factor=1}}) end
callbacks["vm-toggle"] = function()
    local enabled = hl.get_current_submap() ~= "archsetup-vm"
    hl.dispatch(hl.dsp.submap(enabled and "archsetup-vm" or "reset"))
    hl.exec_cmd("notify-send 'VM shortcut passthrough' '" .. (enabled and "Enabled. Super+Alt+F1 restores desktop shortcuts." or "Desktop shortcuts restored.") .. "'")
end
{% for binding in lookup('file', role_path + '/files/shortcuts.json') | from_json %}
{% if binding.submap is defined %}hl.define_submap({{ binding.submap | to_json }}, function()
{% endif %}
hl.bind({{ binding.key | to_json }}, {% if binding.action is defined %}hl.dsp.exec_cmd(action .. " {{ binding.action }}"){% elif binding.callback is defined %}callbacks[{{ binding.callback | to_json }}]{% else %}{{ binding.dispatcher }}{% endif %}, {
    description = {{ binding.description | to_json(ensure_ascii=false) }}{% for flag in ['mouse', 'locked', 'repeating', 'release', 'submap_universal', 'dont_inhibit'] %}{% if binding[flag] | default(false) %}, {{ flag }} = true{% endif %}{% endfor %}
})
{% if binding.submap is defined %}end)
{% endif %}
{% endfor %}
local colors = io.open(root .. "/theme/colors.lua", "r")
if colors then colors:close(); dofile(root .. "/theme/colors.lua") end
local override = io.open(root .. "/overrides.lua", "r")
if override then override:close(); dofile(root .. "/overrides.lua") end
